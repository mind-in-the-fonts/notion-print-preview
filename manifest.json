{
  "manifest_version": 3,
  "name": "Notion Print Preview",
  "version": "0.1.0",
  "description": "Notion 페이지에서 프린트 페이지 구분선을 미리 확인하는 확장 프로그램",
  "permissions": [],
  "host_permissions": [
    "https://*.notion.so/*",
    "https://*.notion.com/*",
    "https://*.notion.site/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.notion.so/*",
        "https://*.notion.com/*",
        "https://*.notion.site/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
